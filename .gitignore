# ── 自动生成的编排文件（由 coderfleet apply 生成）──────────
docker-compose.yml

# ── 账号认证数据（敏感凭据，绝对不能入库）────────────────
accounts/

# ── 任务执行记录与日志 ────────────────────────────────────
tasks/*.json
tasks/*.log
!tasks/.gitkeep

# ── 容器任务临时文件（I/O 解耦写入项目目录）──────────────
.coderfleet-tasks/
.*-tasks/

# ── 任务链会话记录 ────────────────────────────────────────
conversations/*.json
!conversations/.gitkeep

# ── 气泡翻译缓存 ──────────────────────────────────────────
translations/

# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ── macOS ─────────────────────────────────────────────────
.DS_Store

# ── IDE / 编辑器 ──────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

accounts.conf
config.conf
projects.conf

.claude/settings.local.json

.agent

.agents
.claude/skills
# ── 视频等大体积媒体文件 ───────────────────────────────
*.mp4

.claude/worktrees

core

.coderfleet-uploads
.coderfleet-terminals
.*-uploads

server.log

update.sh
skills-lock.json

# ── TokenSave MCP 缓存（本地代码图，无需入库）──────────
.tokensave/